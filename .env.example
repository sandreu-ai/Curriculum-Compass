# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and will never be committed.

# Resend — transactional email provider (https://resend.com)
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional but recommended: saves quiz leads into a specific Resend Audience.
# If omitted, the subscribe route still creates/updates a Resend contact with quiz properties.
RESEND_AUDIENCE_ID=audience_id_here

# Used in email links back to the site
SITE_URL=http://localhost:3001
