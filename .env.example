# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored and will never be committed.

# Resend — transactional email provider (https://resend.com)
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional legacy fallback: saves quiz leads into a specific Resend Audience.
# Prefer RESEND_SEGMENT_IDS for new Resend setups; use either segments or audience, not both.
RESEND_AUDIENCE_ID=audience_id_here

# Optional: comma-separated Resend Segment IDs for durable lead buckets/tags.
RESEND_SEGMENT_IDS=segment_id_here,another_segment_id_here

# Optional: Resend Topic ID to opt quiz leads into the planning sequence topic.
RESEND_TOPIC_ID=topic_id_here

# Optional: sends a minimized internal notification for each quiz lead.
# Useful when the mailbox can receive webmail but IMAP cannot be enabled.
LEAD_NOTIFICATION_EMAIL=info@thecurriculumcompass.com

# Used in email links back to the site
SITE_URL=http://localhost:3001
